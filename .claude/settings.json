{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-sw-version.sh",
            "if": "Bash(git commit*)",
            "statusMessage": "Revisando si hace falta subir la versión del service worker..."
          }
        ]
      }
    ]
  }
}
